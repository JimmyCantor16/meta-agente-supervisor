# =============================================================================
# Backend — Meta-Agente Supervisor
# Copia como `.env` y completa al menos la API key del proveedor de IA.
# =============================================================================

# --- Proveedor de IA por defecto (recomendado: Groq, gratis) ---
# Consigue una key gratis en https://console.groq.com/keys
DEEPSEEK_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.groq.com/openai/v1
DEEPSEEK_MODEL=llama-3.3-70b-versatile
DEEPSEEK_TEMPERATURE=0.2
REQUEST_TIMEOUT=60.0
MAX_RETRIES=3
LOG_LEVEL=INFO

# --- Modo simulado (true = respuestas falsas, sin gastar cupo de IA) ---
USE_MOCK_LLM=false

# --- Multi-modelo con FALLBACK (opcional) ---
# JSON en UNA sola línea. Se prueban EN ORDEN; si uno se agota, salta al siguiente.
# `max_context` (opcional) = tokens que acepta el modelo. Si la petición no cabe,
# el proveedor se salta SIN llamarlo (evita un 413 garantizado). El tier gratis
# de GitHub Models, por ejemplo, corta en 8000.
# Endpoints útiles:
#   Groq:       https://api.groq.com/openai/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter: https://openrouter.ai/api/v1
# LLM_PROVIDERS=[{"name":"groq-70b","base_url":"https://api.groq.com/openai/v1","api_key":"gsk_...","model":"llama-3.3-70b-versatile","max_context":128000},{"name":"groq-8b","base_url":"https://api.groq.com/openai/v1","api_key":"gsk_...","model":"llama-3.1-8b-instant","max_context":128000}]

# --- DeepSeek PRIMERO en la cadena (local por la web, o remoto por API) ---
# local  = deepseek-web-chat corriendo en esta máquina (segunda terminal; ver
#          scripts/dos-terminales.ps1). Sin clave: usa tu sesión web de DeepSeek.
#          Desde Docker la URL ya la pone el compose (host.docker.internal).
# remote = endpoint compatible OpenAI que sirva DeepSeek, con su clave.
# off    = la cadena de siempre. En Render: off (o remote).
DEEPSEEK_MODE=off
# DEEPSEEK_API_URL=http://127.0.0.1:6174      # local (por defecto)
# DEEPSEEK_API_URL=https://api.deepseek.com   # remote (por defecto)
# DEEPSEEK_REMOTE_KEY=
# DEEPSEEK_REMOTE_MODEL=deepseek-chat
# DEEPSEEK_WEB_TIMEOUT=180
# DEEPSEEK_WEB_RPM=10

# --- OpenRouter: red de seguridad SOLO con modelos gratuitos ---
# Van al FINAL de la cadena. Cualquier id que no sea ":free" (u openrouter/free)
# se descarta con un aviso, para no gastar saldo por un error de tecleo.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODELS=openrouter/free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free
# (Los proveedores de GitHub Models se podan solos: están retirados, 410 Gone.
#  Los Llama retirados de Groq —llama-3.3-70b-versatile, llama-3.1-8b-instant—
#  se cambian solos por openai/gpt-oss-120b y qwen/qwen3.8-27b.)

# --- OpenCode: último respaldo gratis (solo máquinas del equipo) ---
# "auto" lo pone al FINAL de la cadena si encuentra el binario de OpenCode
# (en Docker/Render no existe). Lento (~40 s), corre sin herramientas.
# OPENCODE_MODE=auto
# OPENCODE_MODEL=opencode/deepseek-v4.1-flash-free
# OPENCODE_BIN=

# --- Persistencia / proyectos generados ---
DB_PATH=evaluations.db
GENERATED_DIR=generated

# --- Licencia (modelo de negocio) ---
FREE_GENERATION_LIMIT=3
LICENSE_KEYS=META-PRO-2026

# --- Login con Google (opcional; vacío = deshabilitado) ---
# Crea un OAuth Client ID (Aplicación web) en https://console.cloud.google.com
# Orígenes JS: http://localhost:8080 y http://localhost:5173
GOOGLE_CLIENT_ID=

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- Agente experto (IA de pago de los planes Studio y Business) ---
# Sin clave el experto queda apagado y todo funciona con los modelos gratuitos.
# Para probar la mecánica sin gastar: EXPERTO_SIMULADO=true
ANTHROPIC_API_KEY=
EXPERTO_MODELO=claude-opus-4-8
EXPERTO_SIMULADO=false

# Experto SIN pagar: aparta el mejor modelo de tu cadena gratuita poniéndole
# "roles": ["experto"] en LLM_PROVIDERS. Con eso desaparece de la construcción
# (los roles 'prompt' y 'code' dejan de verlo) y solo responde en los tres
# momentos de juicio, así que el plan gratuito literalmente no lo tiene.
#   {"name":"nvidia-deepseek-v4", ..., "roles":["experto"]}
